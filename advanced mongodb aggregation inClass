      "source": [
        "from pprint import pprint\n",
        "\n",
        "# output cursor documents\n",
        "def output_cursor(cursor):\n",
        "  for doc in cursor:\n",
        "    print(doc)\n",
        "\n",
        "def run(collection, pipeline, upto=None, limit=None, pretty=False):\n",
        "    \"\"\"Run `pipeline` against `collection`, optionally truncated to the first\n",
        "    `upto` stages. This is the single most useful debugging habit for\n",
        "    aggregation: build the pipeline one stage at a time and look at what\n",
        "    each stage hands to the next.\"\"\"\n",
        "    stages = pipeline if upto is None else pipeline[:upto]\n",
        "    if limit is not None:\n",
        "        stages = stages + [{\"$limit\": limit}]\n",
        "    print(f\"--- {len(stages)} stage(s) ---\")\n",
        "    for doc in collection.aggregate(stages):\n",
        "        pprint(doc) if pretty else print(doc)"
      ]
    },
