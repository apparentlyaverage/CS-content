    {
      "cell_type": "code",
      "source": [
        "cursor = db.enrolments.aggregate([\n",
        "    {\"$lookup\" : {\n",
        "        \"from\" : \"courses\",\n",
        "        \"localField\" : \"course_title\",\n",
        "        \"foreignField\" : \"title\",\n",
        "        \"as\" : \"course_info\"\n",
